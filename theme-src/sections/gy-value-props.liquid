{%- comment -%}
  GentleYou value propositions — used for "Why GentleYou" and for the product
  benefits section. Every label and line of copy is merchant text from a block,
  so no claim is written into the theme.
{%- endcomment -%}

{{ 'gentleyou.css' | asset_url | stylesheet_tag }}
{{ 'gentleyou-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gentleyou-motion.js' | asset_url }}" defer="defer"></script>

<section
  class="gy-section gy-section--{{ section.settings.tone }} gy-props gy-props--{{ section.settings.layout }}"
  style="--gy-pad-top: {{ section.settings.padding_top }}px; --gy-pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-gy-reveal-scope
  {{ section.shopify_attributes }}
>
  <div class="gy-container">
    <header class="gy-section__head" data-gy-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="gy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gy-section__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="gy-section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <div class="gy-props__body">
      {%- if section.settings.layout == 'with_image' and section.settings.image != blank -%}
        <figure class="gy-props__figure" data-gy-reveal>
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w
            "
            sizes="(min-width: 990px) 44vw, 92vw"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy"
            decoding="async"
          >
        </figure>
      {%- endif -%}

      <ul class="gy-props__list" role="list">
        {%- for block in section.blocks -%}
          <li class="gy-props__item" data-gy-reveal style="--gy-reveal-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="gy-props__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="gy-props__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GentleYou value props",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Why GentleYou" },
    { "type": "richtext", "id": "text", "label": "Supporting text" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "row",
      "options": [ { "value": "row", "label": "Row of points" }, { "value": "with_image", "label": "Image beside points" } ]
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Used with the 'image beside points' layout." },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "ivory",
      "options": [ { "value": "ivory", "label": "Warm ivory" }, { "value": "lavender", "label": "Soft lavender" }, { "value": "deep", "label": "Deep charcoal" } ]
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Soft" },
        { "type": "text", "id": "text", "label": "Text", "info": "Only describe what the product actually offers.", "default": "Comfort-first fabrics" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "GentleYou value props", "blocks": [ { "type": "point" }, { "type": "point" }, { "type": "point" }, { "type": "point" } ] } ]
}
{% endschema %}
