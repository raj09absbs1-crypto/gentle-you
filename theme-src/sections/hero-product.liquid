{%- comment -%}
  GentleYou premium product hero with campaign rotation.

  The merchant adds up to six "Hero product" blocks, each pointing at a Shopify
  product through the native product picker. Every value shown — featured image,
  title, price, compare-at price, saving, availability and URL — is read live
  from that product, so an Admin change appears on the next page render and
  nothing about a product is hardcoded here.

  Price output goes through the existing `snippets/price.liquid`, so currency
  formatting, `settings.currency_code_enabled`, price ranges, volume pricing and
  sold-out handling stay identical to the rest of the theme.

  All slides are rendered server-side and stacked in one grid cell; JavaScript
  only toggles which one is active. There is no product data in JavaScript.
{%- endcomment -%}

{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product_slide'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign slide_count = product_blocks.size

  assign first_product = section.settings.product
  if slide_count > 0
    assign first_block = product_blocks | first
    assign first_product = first_block.settings.product
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = first_product.title
  endif

  assign cta_url = first_product.url | default: section.settings.cta_link
  assign cta_text = section.settings.cta_text | default: 'Shop now'

  assign caption = section.settings.product_caption
  if slide_count > 0 and first_block.settings.caption != blank
    assign caption = first_block.settings.caption
  endif
  if caption == blank
    assign caption = first_product.title
  endif
-%}

{%- if section.settings.enable_section -%}
  {{ 'gentleyou.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'gentleyou-hero.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    #GyHero-{{ section.id }} .gy-hero__inner {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
      --gy-hero-width: {{ settings.page_width }}px;
    }

    @media screen and (min-width: 750px) {
      #GyHero-{{ section.id }} .gy-hero__inner {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="GyHero-{{ section.id }}"
    class="gy-hero gy-hero--{{ section.settings.desktop_layout }}{% if section.settings.background_image != blank %} gy-hero--has-bg-image{% endif %}"
    data-gy-hero
    data-gy-tilt="{{ section.settings.tilt_strength }}"
    data-gy-interval="{{ section.settings.rotation_interval }}"
    data-gy-autoplay="{{ section.settings.enable_rotation }}"
    {% if slide_count > 1 %}
      role="group"
      aria-roledescription="{{ 'sections.hero_product.carousel' | t }}"
      aria-label="{{ 'sections.hero_product.carousel' | t }}"
    {% endif %}
    {{ section.shopify_attributes }}
  >
    <div class="gy-hero__backdrop" data-gy-parallax aria-hidden="true"></div>

    {%- if section.settings.background_image != blank -%}
      <img
        class="gy-hero__bg-image"
        src="{{ section.settings.background_image | image_url: width: 2200 }}"
        srcset="
          {{ section.settings.background_image | image_url: width: 900 }} 900w,
          {{ section.settings.background_image | image_url: width: 1400 }} 1400w,
          {{ section.settings.background_image | image_url: width: 2200 }} 2200w
        "
        sizes="100vw"
        width="{{ section.settings.background_image.width }}"
        height="{{ section.settings.background_image.height }}"
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="low"
      >
    {%- endif -%}

    {%- if section.settings.show_watermark and section.settings.watermark_text != blank -%}
      <span class="gy-hero__watermark" aria-hidden="true">{{ section.settings.watermark_text | escape }}</span>
    {%- endif -%}

    <div class="gy-hero__inner">
      <div class="gy-hero__media">
        <div class="gy-hero__stage" data-gy-stage>
          <span class="gy-hero__glow" aria-hidden="true"></span>

          <div
            class="gy-hero__plate"
            data-gy-product
            {% if section.settings.enable_float %}data-gy-float{% endif %}
          >
            <div class="gy-hero__plate-inner">
              <div class="gy-hero__slides">
                {%- if slide_count > 0 -%}
                  {%- for block in product_blocks -%}
                    {%- render 'gy-hero-media',
                      product: block.settings.product,
                      index: forloop.index0
                    -%}
                  {%- endfor -%}
                {%- else -%}
                  {%- render 'gy-hero-media', product: section.settings.product, index: 0 -%}
                {%- endif -%}
              </div>
              <span class="gy-hero__sheen" aria-hidden="true"></span>
            </div>
          </div>

          {%- if slide_count > 1 -%}
            <button
              class="gy-hero__nav gy-hero__nav--prev"
              type="button"
              data-gy-prev
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 5 8 12l6.5 7"/></svg>
            </button>
            <button
              class="gy-hero__nav gy-hero__nav--next"
              type="button"
              data-gy-next
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 5 16 12l-6.5 7"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if section.settings.show_product_title -%}
          <div class="gy-hero__captions">
            {%- if slide_count > 0 -%}
              {%- for block in product_blocks -%}
                {%- liquid
                  assign block_caption = block.settings.caption
                  if block_caption == blank
                    assign block_caption = block.settings.product.title
                  endif
                -%}
                <p
                  class="gy-hero__product-title{% if forloop.first %} is-active{% endif %}"
                  data-gy-caption="{{ forloop.index0 }}"
                  {% unless forloop.first %}aria-hidden="true"{% endunless %}
                >
                  <span>{{ block_caption | escape }}</span>
                </p>
              {%- endfor -%}
            {%- else -%}
              <p class="gy-hero__product-title is-active" data-gy-caption="0">
                <span>{{ caption | escape }}</span>
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if slide_count > 1 -%}
          <div class="gy-hero__rotation">
            <p class="gy-hero__counter">
              <span data-gy-counter>01</span>
              <span class="gy-hero__counter-sep" aria-hidden="true">/</span>
              <span class="gy-hero__counter-total">{{ slide_count | prepend: '0' | slice: -2, 2 }}</span>
            </p>
            <span class="gy-hero__progress" aria-hidden="true">
              <span class="gy-hero__progress-bar" data-gy-progress></span>
            </span>
          </div>
        {%- endif -%}
      </div>

      <div class="gy-hero__content">
        <h2 class="gy-hero__heading">{{ heading | escape | newline_to_br }}</h2>

        <div class="gy-hero__states" data-gy-states>
          {%- if slide_count > 0 -%}
            {%- for block in product_blocks -%}
              {%- liquid
                assign block_eyebrow = block.settings.eyebrow | default: section.settings.eyebrow
                assign block_text = block.settings.text | default: section.settings.text
              -%}
              {%- render 'gy-hero-state',
                product: block.settings.product,
                index: forloop.index0,
                eyebrow: block_eyebrow,
                text: block_text,
                show_compare_at_price: section.settings.show_compare_at_price,
                show_discount: section.settings.show_discount
              -%}
            {%- endfor -%}
          {%- else -%}
            {%- render 'gy-hero-state',
              product: section.settings.product,
              index: 0,
              eyebrow: section.settings.eyebrow,
              text: section.settings.text,
              show_compare_at_price: section.settings.show_compare_at_price,
              show_discount: section.settings.show_discount
            -%}
          {%- endif -%}
        </div>

        <div class="gy-hero__actions">
          {%- if cta_url != blank -%}
            <a
              class="gy-hero__cta{% if first_product != blank and first_product.available == false %} gy-hero__cta--soft{% endif %}"
              href="{{ cta_url }}"
              data-gy-cta
            >
              {{ cta_text | escape }}
              <span class="gy-hero__cta-arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- else -%}
            <span class="gy-hero__cta" aria-disabled="true">
              {{ cta_text | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.secondary_text != blank -%}
            <p class="gy-hero__secondary">{{ section.settings.secondary_text | escape }}</p>
          {%- endif -%}
        </div>

        {%- if trust_blocks.size > 0 -%}
          <ul class="gy-hero__trust" role="list">
            {%- for block in trust_blocks -%}
              {%- if block.settings.text != blank -%}
                <li class="gy-hero__trust-item" {{ block.shopify_attributes }}>
                  <span class="gy-hero__trust-icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'package' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8.5v7a1 1 0 0 1-.55.9l-7.5 3.9a2 2 0 0 1-1.9 0l-7.5-3.9a1 1 0 0 1-.55-.9v-7"/><path d="M3.2 7.6 11.05 3.7a2 2 0 0 1 1.9 0l7.85 3.9-8.35 4.2a1 1 0 0 1-.9 0z"/><path d="M12 11.9V20"/></svg>
                      {%- when 'exchange' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 0 1-13.3 6"/><path d="M4 12a8 8 0 0 1 13.3-6"/><path d="M17.3 2.6V6h-3.4"/><path d="M6.7 21.4V18h3.4"/></svg>
                      {%- when 'truck' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5h11v10H2z"/><path d="M13 9.5h4l3 3.2v3.8h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8 4.8 5.6v5.5c0 4.2 2.9 7.9 7.2 9.1 4.3-1.2 7.2-4.9 7.2-9.1V5.6z"/><path d="m9 12 2.1 2.2L15.2 10"/></svg>
                    {%- endcase -%}
                  </span>
                  <span class="gy-hero__trust-text">{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.hero-product.name",
  "tag": "section",
  "class": "gy-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "t:sections.hero-product.settings.enable_section.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.hero-product.settings.product_header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.hero-product.settings.product_paragraph.content"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.hero-product.settings.product.label",
      "info": "t:sections.hero-product.settings.product.info"
    },
    {
      "type": "checkbox",
      "id": "show_product_title",
      "label": "t:sections.hero-product.settings.show_product_title.label",
      "default": true
    },
    {
      "type": "text",
      "id": "product_caption",
      "label": "t:sections.hero-product.settings.product_caption.label",
      "info": "t:sections.hero-product.settings.product_caption.info"
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "t:sections.hero-product.settings.show_compare_at_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_discount",
      "label": "t:sections.hero-product.settings.show_discount.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.hero-product.settings.rotation_header.content"
    },
    {
      "type": "checkbox",
      "id": "enable_rotation",
      "label": "t:sections.hero-product.settings.enable_rotation.label",
      "info": "t:sections.hero-product.settings.enable_rotation.info",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_interval",
      "min": 4000,
      "max": 12000,
      "step": 500,
      "unit": "ms",
      "label": "t:sections.hero-product.settings.rotation_interval.label",
      "default": 7500
    },
    {
      "type": "header",
      "content": "t:sections.hero-product.settings.content_header.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero-product.settings.eyebrow.label",
      "default": "Soft. Confident. You."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.hero-product.settings.heading.label",
      "info": "t:sections.hero-product.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.hero-product.settings.text.label",
      "default": "<p>Everyday luxury, made for real comfort. Soft-touch fabric, seamless finish, and a fit that stays gentle from morning to night.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:sections.hero-product.settings.cta_text.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.hero-product.settings.cta_link.label",
      "info": "t:sections.hero-product.settings.cta_link.info"
    },
    {
      "type": "text",
      "id": "secondary_text",
      "label": "t:sections.hero-product.settings.secondary_text.label"
    },
    {
      "type": "header",
      "content": "t:sections.hero-product.settings.layout_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "t:sections.hero-product.settings.show_watermark.label",
      "default": false
    },
    {
      "type": "text",
      "id": "watermark_text",
      "label": "t:sections.hero-product.settings.watermark_text.label",
      "info": "t:sections.hero-product.settings.watermark_text.info",
      "default": "GentleYou"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.hero-product.settings.background_image.label",
      "info": "t:sections.hero-product.settings.background_image.info"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "t:sections.hero-product.settings.desktop_layout.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero-product.settings.desktop_layout.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.hero-product.settings.desktop_layout.options__2.label"
        },
        {
          "value": "center",
          "label": "t:sections.hero-product.settings.desktop_layout.options__3.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:sections.hero-product.settings.motion_header.content"
    },
    {
      "type": "checkbox",
      "id": "enable_float",
      "label": "t:sections.hero-product.settings.enable_float.label",
      "default": true
    },
    {
      "type": "range",
      "id": "tilt_strength",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "deg",
      "label": "t:sections.hero-product.settings.tilt_strength.label",
      "info": "t:sections.hero-product.settings.tilt_strength.info",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "product_slide",
      "name": "t:sections.hero-product.blocks.product_slide.name",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.hero-product.settings.product.label",
          "info": "t:sections.hero-product.settings.product.info"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.hero-product.blocks.product_slide.settings.caption.label",
          "info": "t:sections.hero-product.blocks.product_slide.settings.caption.info"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.hero-product.blocks.product_slide.settings.eyebrow.label",
          "info": "t:sections.hero-product.blocks.product_slide.settings.eyebrow.info"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.hero-product.blocks.product_slide.settings.text.label",
          "info": "t:sections.hero-product.blocks.product_slide.settings.text.info"
        }
      ]
    },
    {
      "type": "trust",
      "name": "t:sections.hero-product.blocks.trust.name",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.hero-product.blocks.trust.settings.icon.label",
          "options": [
            {
              "value": "package",
              "label": "t:sections.hero-product.blocks.trust.settings.icon.options__1.label"
            },
            {
              "value": "exchange",
              "label": "t:sections.hero-product.blocks.trust.settings.icon.options__2.label"
            },
            {
              "value": "shield",
              "label": "t:sections.hero-product.blocks.trust.settings.icon.options__3.label"
            },
            {
              "value": "truck",
              "label": "t:sections.hero-product.blocks.trust.settings.icon.options__4.label"
            }
          ],
          "default": "package"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.hero-product.blocks.trust.settings.text.label",
          "info": "t:sections.hero-product.blocks.trust.settings.text.info",
          "default": "Cash on delivery"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:sections.hero-product.presets.name",
      "blocks": [
        {
          "type": "product_slide"
        }
      ]
    }
  ]
}
{% endschema %}
