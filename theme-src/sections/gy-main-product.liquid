{%- comment -%}
  GentleYou product detail page.

  Presentation only. Every value — media, title, price, compare-at price,
  availability, variants, quantity rules and the description — is read from the
  Shopify product and variant objects. Price rendering goes through the theme's
  existing snippets/price.liquid, the variant picker through
  snippets/product-variant-picker.liquid and the purchase form through
  snippets/buy-buttons.liquid, so Dawn's product-info.js / product-form.js /
  cart.js contract and the Shiprocket Fastrr inputs are untouched.
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign variant = product.selected_or_first_available_variant
  assign compare_at = variant.compare_at_price
  assign current_price = variant.price

  assign discount_percent = 0
  if compare_at > current_price and compare_at > 0
    assign discount_diff = compare_at | minus: current_price | times: 100.0
    assign discount_percent = discount_diff | divided_by: compare_at | round
  endif
-%}

