{%- comment -%}
  GentleYou product detail page.

  Presentation only. Every value — media, title, price, compare-at price,
  availability, variants, quantity rules and the description — is read from the
  Shopify product and variant objects. Price rendering goes through the theme's
  existing snippets/price.liquid, the variant picker through
  snippets/product-variant-picker.liquid and the purchase form through
  snippets/buy-buttons.liquid, so Dawn's product-info.js / product-form.js /
  cart.js contract and the Shiprocket Fastrr inputs are untouched.
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign variant = product.selected_or_first_available_variant
  assign compare_at = variant.compare_at_price
  assign current_price = variant.price

  assign discount_percent = 0
  if compare_at > current_price and compare_at > 0
    assign discount_diff = compare_at | minus: current_price | times: 100.0
    assign discount_percent = discount_diff | divided_by: compare_at | round
  endif
-%}

{{ 'gentleyou.css' | asset_url | stylesheet_tag }}
{{ 'gentleyou-home.css' | asset_url | stylesheet_tag }}
{{ 'gy-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gy-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gentleyou-motion.js' | asset_url }}" defer="defer"></script>

<product-info
  id="MainProduct-{{ section.id }}"
  class="gy-pdp gy-section gy-section--ivory"
  style="--gy-pad-top: {{ section.settings.padding_top }}px; --gy-pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {{ section.shopify_attributes }}
>
  <div class="gy-container gy-pdp__inner">
    <div class="gy-pdp__media">
      {%- render 'gy-product-gallery',
        product: product,
        section_id: section.id,
        zoom: section.settings.enable_zoom
      -%}
    </div>

    <div class="gy-pdp__info" id="ProductInfo-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="gy-pdp__app" {{ block.shopify_attributes }}>{% render block %}</div>

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="gy-pdp__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="gy-pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

          {%- when 'price' -%}
            <div class="gy-pdp__price-block" {{ block.shopify_attributes }}>
              <div id="price-{{ section.id }}" class="gy-pdp__price" role="status">
                {%- render 'price', product: product, use_variant: true, show_badges: false, price_class: 'price--large' -%}
              </div>

              <div class="gy-pdp__price-meta" id="PriceMeta-{{ section.id }}">
                {%- if compare_at > current_price -%}
                  <span class="gy-pdp__compare">
                    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                    {%- if settings.currency_code_enabled -%}
                      {{ compare_at | money_with_currency }}
                    {%- else -%}
                      {{ compare_at | money }}
                    {%- endif -%}
                  </span>
                  {%- if block.settings.show_saving and discount_percent > 0 -%}
                    <span class="gy-pdp__saving">
                      {{ 'sections.hero_product.discount_html' | t: percent: discount_percent }}
                    </span>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.show_tax_note -%}
                  <span class="gy-pdp__tax">{{ 'products.product.include_taxes' | t }}</span>
                {%- endif -%}
              </div>

              <div
                id="Inventory-{{ section.id }}"
                class="gy-pdp__stock{% unless product.selected_or_first_available_variant.inventory_management == 'shopify' %} gy-pdp__stock--hidden{% endunless %}"
                role="status"
              >
                {%- if variant.available -%}
                  {%- if variant.inventory_management == 'shopify'
                    and variant.inventory_quantity > 0
                    and variant.inventory_quantity <= block.settings.inventory_threshold
                  -%}
                    {{ 'products.product.inventory_low_stock' | t }}
                  {%- else -%}
                    {{ 'products.product.inventory_in_stock' | t }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'products.product.inventory_out_of_stock' | t }}
                {%- endif -%}
              </div>
            </div>

          {%- when 'variant_picker' -%}
            <div class="gy-pdp__variants">
              <div class="gy-pdp__variants-head">
                <div>
                  {%- if block.settings.heading != blank -%}
                    <p class="gy-pdp__variants-title">{{ block.settings.heading | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <p class="gy-pdp__variants-sub">{{ block.settings.subheading | escape }}</p>
                  {%- endif -%}
                </div>

                {%- if block.settings.show_size_guide -%}
                  <button class="gy-pdp__size-link" type="button" data-gy-size-guide-open aria-haspopup="dialog">
                    {{ section.settings.size_guide_label | default: 'Size guide' | escape }}
                    <span aria-hidden="true">&rarr;</span>
                  </button>
                {%- endif -%}
              </div>

              {%- render 'product-variant-picker',
                product: product,
                block: block,
                product_form_id: product_form_id
              -%}
            </div>

          {%- when 'quantity_selector' -%}
            {%- liquid
              assign cart_qty = cart | item_count_for_variant: variant.id
            -%}
            <div class="gy-pdp__quantity product-form__input product-form__quantity" id="Quantity-Form-{{ section.id }}" {{ block.shopify_attributes }}>
              <label class="quantity__label form__label" for="Quantity-{{ section.id }}">
                {{ 'products.product.quantity.label' | t }}
                <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}">
                  {%- render 'loading-spinner' -%}
                  <span>({{ 'products.product.quantity.in_cart_html' | t: quantity: cart_qty }})</span>
                </span>
              </label>
              <quantity-input class="quantity" data-url="{{ product.url }}" data-section="{{ section.id }}">
                <button class="quantity__button" name="minus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span>
                  <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                </button>
                <input
                  class="quantity__input"
                  type="number"
                  name="quantity"
                  id="Quantity-{{ section.id }}"
                  data-cart-quantity="{{ cart_qty }}"
                  data-min="{{ variant.quantity_rule.min }}"
                  min="{{ variant.quantity_rule.min }}"
                  {% if variant.quantity_rule.max != null %}
                    data-max="{{ variant.quantity_rule.max }}"
                    max="{{ variant.quantity_rule.max }}"
                  {% endif %}
                  step="{{ variant.quantity_rule.increment }}"
                  value="{{ variant.quantity_rule.min }}"
                  form="{{ product_form_id }}"
                >
                <button class="quantity__button" name="plus" type="button">
                  <span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span>
                  <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                </button>
              </quantity-input>
              <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}"></div>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="gy-pdp__buy" {{ block.shopify_attributes }}>
              {%- render 'buy-buttons',
                block: block,
                product: product,
                product_form_id: product_form_id,
                section_id: section.id,
                show_pickup_availability: true
              -%}
            </div>

          {%- when 'highlights' -%}
            {%- comment -%}
              Editorial presentation of the product's own Shopify description.
              The lines below are the merchant's own text split on the bullet
              glyphs already used in Admin — nothing is added or rewritten.
            {%- endcomment -%}
            {%- liquid
              assign source = product.description | replace: '<br>', '✔' | replace: '<br/>', '✔' | replace: '<br />', '✔'
              assign source = source | replace: '</p>', '✔' | replace: '</li>', '✔'
              assign source = source | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&'
              assign source = source | replace: 'Product Description:', '' | replace: 'Product description:', ''
              assign source = source | replace: '✓', '✔' | replace: '•', '✔'
              assign lines = source | split: '✔'
            -%}
            {%- assign printed = 0 -%}
            <div class="gy-pdp__highlights" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="gy-pdp__highlights-heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              <ul role="list">
                {%- for line in lines -%}
                  {%- assign clean = line | strip -%}
                  {%- if clean != blank and clean.size > 2 and printed < block.settings.max_lines -%}
                    <li>{{ clean }}</li>
                    {%- assign printed = printed | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'short_description' -%}
            {%- liquid
              assign words = block.settings.words | default: 32
              assign short = product.description | strip_html | replace: '&nbsp;', ' ' | replace: '&amp;', '&'
              assign short = short | replace: 'Product Description:', '' | replace: 'Product description:', ''
              assign short = short | replace: '✔', '' | replace: '✓', '' | replace: '•', ''
              assign short = short | strip | truncatewords: words
            -%}
            {%- if short != blank -%}
              <p class="gy-pdp__short" {{ block.shopify_attributes }}>{{ short }}</p>
            {%- endif -%}

          {%- when 'trust' -%}
            <ul class="gy-pdp__trust" role="list" {{ block.shopify_attributes }}>
              {%- assign points = block.settings.points | split: '|' -%}
              {%- for point in points -%}
                <li>{{ point | strip }}</li>
              {%- endfor -%}
            </ul>

          {%- when 'details' -%}
            {%- liquid
              assign body = block.settings.content
              if block.settings.source == 'description' and product.description != blank
                assign body = product.description
              endif
            -%}
            {%- if body != blank -%}
              <details class="gy-pdp__accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.heading | escape }}</span>
                  <span class="gy-pdp__accordion-icon" aria-hidden="true"></span>
                </summary>
                <div class="gy-pdp__accordion-body rte">{{ body }}</div>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%}
    Size guide.

    Band and cup values are the product's real Shopify option values — the
    theme never invents a size. Measurements come only from what the merchant
    supplies: a `size_measurements` line per size, or a product metafield when
    one is set. Where nothing is supplied the column simply stays empty rather
    than showing a fabricated number.
  {%- endcomment -%}
  {%- liquid
    assign band_option = null
    assign cup_option = null
    for option in product.options_with_values
      assign lower_name = option.name | downcase
      if band_option == null and lower_name contains section.settings.band_option_name
        assign band_option = option
      endif
      if cup_option == null and lower_name contains section.settings.cup_option_name
        assign cup_option = option
      endif
    endfor

    assign measurement_lines = section.settings.size_measurements | newline_to_br | split: '<br />'
    assign metafield_chart = product.metafields.custom.size_chart
  -%}

  <div class="gy-pdp__drawer" data-gy-size-guide-drawer hidden>
    <div class="gy-pdp__drawer-scrim" data-gy-size-guide-close></div>
    <aside
      class="gy-pdp__drawer-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="SizeGuideTitle-{{ section.id }}"
      tabindex="-1"
    >
      <header class="gy-pdp__drawer-head">
        <div>
          <p class="gy-pdp__drawer-title" id="SizeGuideTitle-{{ section.id }}">
            {{ section.settings.size_guide_heading | default: 'Find your best fit.' | escape }}
          </p>
          {%- if section.settings.size_guide_intro != blank -%}
            <p class="gy-pdp__drawer-intro">{{ section.settings.size_guide_intro | escape }}</p>
          {%- endif -%}
        </div>
        <button
          class="gy-pdp__drawer-close"
          type="button"
          data-gy-size-guide-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          &times;
        </button>
      </header>

      <div class="gy-pdp__drawer-body">
        {%- if band_option != blank and section.settings.size_measurements != blank -%}
          <section class="gy-guide__block">
            <h3 class="gy-guide__label">{{ band_option.name }}</h3>
            <table class="gy-guide__table">
              <thead>
                <tr>
                  <th scope="col">{{ band_option.name }}</th>
                  <th scope="col">{{ section.settings.measurement_label | default: 'Underbust' | escape }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for value in band_option.values -%}
                  {%- liquid
                    assign measurement = ''
                    for line in measurement_lines
                      assign parts = line | strip | split: ':'
                      assign key = parts[0] | strip
                      if key == value.name and parts.size > 1
                        assign measurement = parts[1] | strip
                      endif
                    endfor
                  -%}
                  <tr {% if value.selected %}class="is-current"{% endif %}>
                    <th scope="row">{{ value.name }}</th>
                    <td>
                      {%- if measurement != blank -%}
                        {{ measurement }}
                      {%- else -%}
                        <span class="gy-guide__blank" aria-hidden="true">&mdash;</span>
                        <span class="visually-hidden">{{ 'sections.gy.measurement_not_set' | t }}</span>
                      {%- endif -%}
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </section>
        {%- endif -%}

        {%- if cup_option != blank and section.settings.size_chart_rows == blank -%}
          <section class="gy-guide__block">
            <h3 class="gy-guide__label">{{ cup_option.name }}</h3>
            <ul class="gy-guide__cups" role="list">
              {%- for value in cup_option.values -%}
                <li class="{% if value.selected %}is-current{% endif %}">{{ value.name }}</li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- if metafield_chart != blank -%}
          <section class="gy-guide__block gy-guide__metafield rte">
            {{ metafield_chart | metafield_tag }}
          </section>
        {%- endif -%}

        {%- comment -%}
          Size chart. Rows are merchant content from the Theme Editor (one row
          per line, columns separated by |), so the numbers are whatever the
          merchant published and the theme never derives or converts them.
          When the shopper's selected band and cup match a row's size code the
          row is highlighted; the Shopify variant picker is untouched.
        {%- endcomment -%}
        {%- if section.settings.size_chart_rows != blank -%}
          {%- liquid
            assign chart_headers = section.settings.size_chart_columns | split: '|'
            assign chart_rows = section.settings.size_chart_rows | newline_to_br | split: '<br />'

            assign selected_band = ''
            assign selected_cup = ''
            if band_option != blank
              assign selected_band = band_option.selected_value.name | default: ''
            endif
            if cup_option != blank
              assign selected_cup = cup_option.selected_value.name | default: ''
            endif
            assign current_code = selected_band | append: selected_cup | upcase | strip
          -%}

          <section class="gy-guide__block gy-chart">
            <header class="gy-chart__head">
              <h3 class="gy-chart__title">{{ section.settings.size_chart_heading | default: 'Size chart' | escape }}</h3>
              {%- if section.settings.size_chart_category != blank -%}
                <p class="gy-chart__category">{{ section.settings.size_chart_category | escape }}</p>
              {%- endif -%}
            </header>

            <div class="gy-chart__wrap" data-gy-chart-wrap>
            <div class="gy-chart__scroll" tabindex="0" role="group" aria-label="{{ section.settings.size_chart_heading | default: 'Size chart' | escape }}" data-gy-chart-scroll>
              <table class="gy-chart__table">
                <thead>
                  <tr>
                    {%- for header in chart_headers -%}
                      <th scope="col">{{ header | strip }}</th>
                    {%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for row in chart_rows -%}
                    {%- assign cells = row | strip | split: '|' -%}
                    {%- if cells.size > 0 and row != blank -%}
                      {%- assign row_code = cells[0] | strip | upcase -%}
                      <tr {% if current_code != blank and row_code == current_code %}class="is-current" aria-current="true"{% endif %}>
                        {%- for cell in cells -%}
                          {%- if forloop.first -%}
                            <th scope="row">{{ cell | strip }}</th>
                          {%- else -%}
                            <td>{{ cell | strip }}</td>
                          {%- endif -%}
                        {%- endfor -%}
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            <p class="gy-chart__hint" data-gy-chart-hint>{{ 'sections.gy.swipe_table' | t }}</p>
            </div>
          </section>
        {%- endif -%}

        {%- if section.settings.measure_step_1 != blank or section.settings.measure_step_2 != blank -%}
          <section class="gy-guide__block">
            <h3 class="gy-guide__label">{{ section.settings.measure_heading | default: 'How to measure' | escape }}</h3>
            <ol class="gy-guide__steps" role="list">
              {%- if section.settings.measure_step_1 != blank -%}
                <li>
                  <span class="gy-guide__step-number">01</span>
                  <div>
                    <p class="gy-guide__step-title">{{ section.settings.measure_step_1_title | escape }}</p>
                    <p class="gy-guide__step-text">{{ section.settings.measure_step_1 | escape }}</p>
                  </div>
                </li>
              {%- endif -%}
              {%- if section.settings.measure_step_2 != blank -%}
                <li>
                  <span class="gy-guide__step-number">02</span>
                  <div>
                    <p class="gy-guide__step-title">{{ section.settings.measure_step_2_title | escape }}</p>
                    <p class="gy-guide__step-text">{{ section.settings.measure_step_2 | escape }}</p>
                  </div>
                </li>
              {%- endif -%}
            </ol>
          </section>
        {%- endif -%}

        {%- if section.settings.between_sizes != blank -%}
          <section class="gy-guide__block gy-guide__note">
            <h3 class="gy-guide__label">{{ section.settings.between_sizes_heading | default: 'Between sizes?' | escape }}</h3>
            <p>{{ section.settings.between_sizes | escape }}</p>
          </section>
        {%- endif -%}

        {%- if section.settings.size_note != blank or section.settings.size_contact != blank -%}
          <div class="gy-guide__footnote">
            {%- if section.settings.size_note != blank -%}
              <p>{{ section.settings.size_note | escape }}</p>
            {%- endif -%}
            {%- if section.settings.size_contact != blank -%}
              <p>{{ section.settings.size_contact | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.size_guide_text != blank -%}
          <div class="gy-guide__block rte">{{ section.settings.size_guide_text }}</div>
        {%- endif -%}
      </div>
    </aside>
  </div>

  {%- if section.settings.enable_sticky_bar -%}
    <div class="gy-pdp__sticky" data-gy-sticky-bar hidden>
      <div class="gy-pdp__sticky-inner">
        <div class="gy-pdp__sticky-media">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 120 }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              alt=""
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="gy-pdp__sticky-text">
          <p class="gy-pdp__sticky-title">{{ product.title }}</p>
          <p class="gy-pdp__sticky-price">
            {%- render 'price', product: product, use_variant: true -%}
          </p>
        </div>
        <button class="gy-button gy-pdp__sticky-button" type="button" data-gy-sticky-add>
          {{ 'products.product.add_to_cart' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}
</product-info>

{% schema %}
{
  "name": "GentleYou product",
  "tag": "section",
  "class": "gy-pdp-section",
  "settings": [
    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "enable_zoom", "label": "Open the active image full size on click", "default": true },
    { "type": "header", "content": "Size guide" },
    { "type": "text", "id": "size_guide_label", "label": "Trigger label", "default": "Size guide" },
    { "type": "text", "id": "size_guide_heading", "label": "Heading", "default": "Find your best fit." },
    { "type": "text", "id": "size_guide_intro", "label": "Supporting line", "default": "Simple measurements to help you choose comfortably." },
    { "type": "text", "id": "band_option_name", "label": "Band option name contains", "info": "Which product option holds the band size. Lower case.", "default": "size" },
    { "type": "text", "id": "cup_option_name", "label": "Cup option name contains", "info": "Which product option holds the cup size. Lower case.", "default": "cup" },
    { "type": "text", "id": "measurement_label", "label": "Measurement column heading", "default": "Underbust" },
    { "type": "textarea", "id": "size_measurements", "label": "Measurements", "info": "One per line as \"size: measurement\", for example \"32: 68-72 cm\". Sizes with nothing here show an empty cell — the theme never invents a measurement. A product metafield custom.size_chart is also rendered when set." },
    { "type": "text", "id": "size_chart_heading", "label": "Size chart heading", "default": "Size chart" },
    { "type": "text", "id": "size_chart_category", "label": "Size chart category", "default": "Bras" },
    { "type": "text", "id": "size_chart_columns", "label": "Size chart column headings", "info": "Separated by |.", "default": "Size|Underbust (inch)|Bust (inch)|UK size|EU size" },
    { "type": "textarea", "id": "size_chart_rows", "label": "Size chart rows", "info": "One row per line, columns separated by |. The first column is matched against the selected band and cup to highlight a row." },
    { "type": "text", "id": "measure_heading", "label": "How to measure heading", "default": "How to measure" },
    { "type": "text", "id": "measure_step_1_title", "label": "Step 1 title", "default": "Measure your band" },
    { "type": "textarea", "id": "measure_step_1", "label": "Step 1 text", "default": "Wrap the measuring tape firmly around your ribcage, directly underneath your bust." },
    { "type": "text", "id": "measure_step_2_title", "label": "Step 2 title", "default": "Measure your bust" },
    { "type": "textarea", "id": "measure_step_2", "label": "Step 2 text", "default": "Measure around the fullest part of your bust without pulling the tape too tightly." },
    { "type": "text", "id": "between_sizes_heading", "label": "Between sizes heading", "default": "Between sizes?" },
    { "type": "textarea", "id": "between_sizes", "label": "Between sizes text", "default": "If you're between sizes, we recommend choosing the larger size for a more comfortable everyday fit." },
    { "type": "textarea", "id": "size_note", "label": "Size note", "default": "Fit can vary slightly by style and fabric. Please check the available options on the product page before ordering." },
    { "type": "text", "id": "size_contact", "label": "Help line", "info": "Optional. Shown under the size note." },
    { "type": "richtext", "id": "size_guide_text", "label": "Extra content", "info": "Optional. Appears at the end of the panel." },
