{%- comment -%}
  GentleYou search results.

  Everything rendered comes from Shopify's own `search` object: the terms, the
  result count, the resources and the pagination. Products go through the same
  snippets/gy-card-product used by the collection pages, so prices, compare-at
  prices, sale states and availability are read from Shopify exactly as they
  are elsewhere. Nothing is hardcoded and there is no second search index.
{%- endcomment -%}

{{ 'gentleyou.css' | asset_url | stylesheet_tag }}
{{ 'gentleyou-home.css' | asset_url | stylesheet_tag }}
{{ 'gy-collection.css' | asset_url | stylesheet_tag }}
{{ 'gy-search.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gentleyou-motion.js' | asset_url }}" defer="defer"></script>

{%- paginate search.results by section.settings.results_per_page -%}
  <section
    class="gy-searchpage"
    style="--gy-section-top: {{ section.settings.padding_top }}px; --gy-section-bottom: {{ section.settings.padding_bottom }}px;"
    {{ section.shopify_attributes }}
  >
    <div class="gy-container">
      <header class="gy-searchpage__head">
        <p class="gy-searchpage__eyebrow">{{ 'templates.search.title' | t }}</p>

        {%- if search.performed and search.terms != blank -%}
          <h1 class="gy-searchpage__title">
            {{ 'sections.gy.search_results_for' | t }}
            <em>&ldquo;{{ search.terms | escape }}&rdquo;</em>
          </h1>
        {%- else -%}
          <h1 class="gy-searchpage__title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}

        <form action="{{ routes.search_url }}" method="get" role="search" class="gy-searchpage__form">
          <label class="visually-hidden" for="GySearchPageInput">{{ 'general.search.search' | t }}</label>
          <span class="gy-searchpage__form-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><circle cx="11" cy="11" r="6.2"/><path d="m15.6 15.6 4.1 4.1"/></svg>
          </span>
          <input
            class="gy-searchpage__input"
            id="GySearchPageInput"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'sections.gy.search_placeholder' | t }}"
            autocomplete="off"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button class="gy-button gy-searchpage__submit" type="submit">
            {{ 'general.search.search' | t }}
          </button>
        </form>

        {%- if search.performed -%}
          <p class="gy-searchpage__count" aria-live="polite">
            {{ 'templates.search.results_with_count' | t: count: search.results_count }}
          </p>
        {%- endif -%}
      </header>

      {%- if search.performed and search.results_count > 0 -%}
        <div class="gy-grid gy-grid--{{ section.settings.columns }} gy-searchpage__grid">
          {%- for item in search.results -%}
            {%- liquid
              assign card_eager = false
              if forloop.index <= 4
                assign card_eager = true
              endif
            -%}
            <div class="gy-grid__item" data-gy-reveal style="--gy-reveal-delay: {{ forloop.index0 | modulo: 4 | times: 60 }}ms">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {%- render 'gy-card-product',
                    card_product: item,
                    ratio: section.settings.image_ratio,
                    eager: card_eager,
                    show_secondary_image: section.settings.show_secondary_image,
                    quick_add: false,
                    section_id: section.id
                  -%}
                {%- else -%}
                  <a class="gy-searchpage__editorial" href="{{ item.url }}">
                    <span class="gy-searchpage__editorial-kind">{{ item.object_type }}</span>
                    <span class="gy-searchpage__editorial-title">{{ item.title | escape }}</span>
                  </a>
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="gy-pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}
              <a class="gy-pagination__step" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a>
            {%- endif -%}
            <ol role="list">
              {%- for part in paginate.parts -%}
                <li>
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}">{{ part.title }}</a>
                  {%- elsif part.title == paginate.current_page -%}
                    <span aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span>{{ part.title }}</span>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ol>
            {%- if paginate.next -%}
              <a class="gy-pagination__step" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}

      {%- else -%}
        {%- comment -%}
          Both the no-results state and the state before anyone has searched.
          The destinations underneath are the merchant's own menu links, so no
          collection URL is invented here.
        {%- endcomment -%}
        <div class="gy-searchpage__empty">
          {%- if search.performed -%}
            <p class="gy-searchpage__empty-title">
              {{ 'templates.search.no_results' | t: terms: search.terms }}
            </p>
            <p class="gy-searchpage__empty-text">{{ 'sections.gy.search_no_results_text' | t }}</p>
          {%- else -%}
            <p class="gy-searchpage__empty-title">{{ section.settings.empty_title | escape }}</p>
            <p class="gy-searchpage__empty-text">{{ section.settings.empty_text | escape }}</p>
          {%- endif -%}

          {%- if section.settings.suggestions.links.size > 0 -%}
            <div class="gy-searchpage__explore">
              <p class="gy-searchpage__explore-heading">
                {{ section.settings.suggestions_heading | escape }}
              </p>
              <ul class="gy-searchpage__explore-list" role="list">
                {%- for link in section.settings.suggestions.links limit: 6 -%}
                  <li><a class="gy-button gy-button--outline" href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "GentleYou search",
  "tag": "section",
  "class": "gy-searchpage-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading before a search", "default": "Find your everyday favourite." },
    { "type": "range", "id": "results_per_page", "min": 8, "max": 48, "step": 4, "label": "Results per page", "default": 24 },
    {
      "type": "select", "id": "columns", "label": "Columns on desktop", "default": "4",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait",
      "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" } ]
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show the second image on hover", "default": true },
    { "type": "header", "content": "Empty and no-results state" },
    { "type": "text", "id": "empty_title", "label": "Title before a search", "default": "What are you looking for?" },
    { "type": "textarea", "id": "empty_text", "label": "Text before a search", "default": "Search by style, size or fabric — or start with one of the edits below." },
    { "type": "text", "id": "suggestions_heading", "label": "Suggestions heading", "default": "Explore" },
    { "type": "link_list", "id": "suggestions", "label": "Suggested destinations", "info": "Only links you choose here are shown, so every destination is one that exists.", "default": "main-menu" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "enabled_on": { "templates": ["search"] }
}
{% endschema %}
