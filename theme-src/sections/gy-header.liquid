{%- comment -%}
  GentleYou header.

  Navigation comes from the Shopify menus the merchant selects, the cart count
  comes from the live cart object, and the cart, search and account links use
  Shopify's own routes — so existing cart and checkout behaviour is untouched.
{%- endcomment -%}

{{ 'gentleyou.css' | asset_url | stylesheet_tag }}
{{ 'gentleyou-home.css' | asset_url | stylesheet_tag }}
{{ 'gy-cart.css' | asset_url | stylesheet_tag }}
{{ 'gy-search.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Loaded once here, from the section group that is present on every page, so
  Dawn's own content pages (404, page, contact, list-collections, blog,
  article, customer accounts) inherit the GentleYou visual language. Every
  rule inside is scoped to a container that only exists on those pages.
{%- endcomment -%}
{{ 'gy-static.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Hover and focus micro-interactions for the whole store, in one layer so
  the response to a pointer is consistent from the header to the footer.
  It only adds rules inside :hover / :focus-visible, so it cannot move
  anything at rest.
{%- endcomment -%}
{{ 'gy-interactions.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gentleyou-motion.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gy-search.js' | asset_url }}" defer="defer"></script>

<header
  class="gy-header{% if section.settings.sticky %} gy-header--sticky{% endif %}"
  data-gy-header
  {{ section.shopify_attributes }}
>
  <div class="gy-header__inner">
    <details class="gy-header__drawer" data-gy-drawer>
      <summary class="gy-header__icon gy-header__burger" aria-label="{{ 'sections.header.menu' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M3.5 7.5h17M3.5 12h17M3.5 16.5h17"/></svg>
      </summary>
      <div class="gy-header__drawer-panel">
        <nav aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="gy-header__drawer-list" role="list">
            {%- for link in section.settings.menu.links -%}
              <li>
                <a class="gy-header__drawer-link" href="{{ link.url }}">{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <ul class="gy-header__drawer-sub" role="list">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      </div>
    </details>

    <a class="gy-header__logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 480 }}"
          srcset="{{ section.settings.logo | image_url: width: 240 }} 240w, {{ section.settings.logo | image_url: width: 480 }} 480w"
          sizes="{{ section.settings.logo_width }}px"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          style="width: {{ section.settings.logo_width }}px"
          alt="{{ shop.name | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <span class="gy-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="gy-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="gy-header__list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="gy-header__item{% if link.links.size > 0 %} gy-header__item--has-children{% endif %}">
            <a class="gy-header__link{% if link.active or link.child_active %} is-active{% endif %}" href="{{ link.url }}">
              {{ link.title }}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="gy-header__submenu">
                <ul role="list">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="gy-header__actions">
      {%- comment -%}
        Still a real link to Shopify's search page, so search works with no
        JavaScript; gy-search.js takes it over to open the overlay instead.
      {%- endcomment -%}
      <a
        class="gy-header__icon"
        href="{{ routes.search_url }}"
        data-gy-search-open
        aria-controls="GySearchOverlay"
        aria-label="{{ 'general.search.search' | t }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.2"/><path d="m15.6 15.6 4.1 4.1"/></svg>
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a class="gy-header__icon gy-header__icon--account" href="{{ routes.account_url }}" aria-label="{{ 'customer.account.title' | t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6"/><path d="M4.8 19.6a7.4 7.4 0 0 1 14.4 0"/></svg>
        </a>
      {%- endif -%}

      <a
        class="gy-header__icon gy-header__cart"
        href="{{ routes.cart_url }}"
        id="cart-icon-bubble"
        aria-label="{{ 'general.cart.view' | t: count: cart.item_count }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 7.5h13l-1.2 12H6.7z"/><path d="M9 7.5V6a3 3 0 0 1 6 0v1.5"/></svg>
        {%- if cart.item_count > 0 -%}
          <div class="cart-count-bubble gy-header__count">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{%- render 'gy-header-search',
  input_id: 'GySearchInput',
  suggestions: section.settings.search_suggestions,
  suggestions_heading: section.settings.search_suggestions_heading
-%}

{% schema %}
{
  "name": "GentleYou header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 260, "step": 10, "unit": "px", "label": "Logo width", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky on scroll", "default": true },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "search_suggestions_heading", "label": "Suggestions heading", "default": "Popular right now" },
    { "type": "link_list", "id": "search_suggestions", "label": "Suggested destinations", "info": "Shown in the search overlay before the shopper types. Only the links you choose here appear, so every destination is one that exists.", "default": "main-menu" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
