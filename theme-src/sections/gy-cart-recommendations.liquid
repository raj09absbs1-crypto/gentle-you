{%- comment -%}
  GentleYou cart recommendations.

  Rendered by Shopify's recommendations endpoint for the first product in the
  cart, fetched by <product-recommendations> from global.js — no new
  JavaScript, no second source of product data. Anything already in the cart is
  skipped, and if Shopify returns nothing the section renders nothing.

  Cards are the theme's own product card, so quick add is offered only where a
  product has a single purchasable variant; everything with a size or a cup to
  choose sends the shopper to its product page instead.
{%- endcomment -%}

{%- liquid
  assign limit = section.settings.products_to_show | default: 2
  assign shown = 0
-%}

{%- if recommendations.performed and recommendations.products_count > 0 -%}
  {%- capture cart_product_ids -%}
    {%- for item in cart.items -%}{{ item.product_id }},{%- endfor -%}
  {%- endcapture -%}

  {%- capture cards -%}
    {%- for recommendation in recommendations.products -%}
      {%- liquid
        assign needle = recommendation.id | append: ','
        assign in_cart = false
        if cart_product_ids contains needle
          assign in_cart = true
        endif
      -%}
      {%- if in_cart == false and recommendation.available and shown < limit -%}
        {%- assign shown = shown | plus: 1 -%}
        <li class="gy-cart-rec__item">
          {%- render 'gy-card-product',
            card_product: recommendation,
            ratio: 'portrait',
            quick_add: true,
            section_id: section.id
          -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if shown > 0 -%}
    <div class="gy-cart-rec">
      <p class="gy-cart-rec__heading">{{ section.settings.heading | escape }}</p>
      <ul class="gy-cart-rec__list" role="list">{{ cards }}</ul>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "GentleYou cart picks",
  "settings": [
    { "type": "paragraph", "content": "Shown inside the cart drawer, based on Shopify's recommendations for the first product in the cart. Products already in the cart are skipped." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete your order" },
    { "type": "range", "id": "products_to_show", "min": 1, "max": 2, "step": 1, "label": "Products to show", "default": 2 }
  ]
}
{% endschema %}
