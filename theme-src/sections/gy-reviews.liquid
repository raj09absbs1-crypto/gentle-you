{%- comment -%}
  GentleYou review section.

  This is a premium frame around the store's existing review app. Reviews are
  rendered by the app block the merchant adds (Judge.me on this store); the
  theme neither stores nor invents ratings, counts or testimonials.
{%- endcomment -%}

{{ 'gentleyou.css' | asset_url | stylesheet_tag }}
{{ 'gentleyou-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gentleyou-motion.js' | asset_url }}" defer="defer"></script>

<section
  class="gy-section gy-section--{{ section.settings.tone }} gy-reviews"
  style="--gy-pad-top: {{ section.settings.padding_top }}px; --gy-pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-gy-reveal-scope
  {{ section.shopify_attributes }}
>
  <div class="gy-container">
    <header class="gy-section__head" data-gy-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="gy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gy-section__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="gy-section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    <div class="gy-reviews__app" data-gy-reveal>
      {%- for block in section.blocks -%}
        <div class="gy-reviews__block" {{ block.shopify_attributes }}>
          {%- render block -%}
        </div>
      {%- else -%}
        <p class="gy-section__empty">{{ 'sections.gy.add_review_app' | t }}</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GentleYou reviews",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Add your review app block (for example Judge.me) so real reviews appear here. The theme never creates review content." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Loved for the way it feels." },
    { "type": "richtext", "id": "text", "label": "Supporting text" },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "ivory",
      "options": [ { "value": "ivory", "label": "Warm ivory" }, { "value": "lavender", "label": "Soft lavender" }, { "value": "deep", "label": "Deep charcoal" } ]
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "GentleYou reviews" } ]
}
{% endschema %}
