{%- comment -%}
  GentleYou product grid — used for Best Sellers and for the pack / combo
  showcase. Products, prices and availability come from the Shopify collection
  the merchant selects; nothing is hardcoded.
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}

{{ 'gentleyou.css' | asset_url | stylesheet_tag }}
{{ 'gentleyou-home.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gentleyou-motion.js' | asset_url }}" defer="defer"></script>

<section
  class="gy-section gy-section--{{ section.settings.tone }} gy-grid-section gy-grid-section--{{ section.settings.style }}"
  style="--gy-pad-top: {{ section.settings.padding_top }}px; --gy-pad-bottom: {{ section.settings.padding_bottom }}px;"
  data-gy-reveal-scope
  {{ section.shopify_attributes }}
>
  <div class="gy-container">
    <header class="gy-section__head" data-gy-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="gy-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gy-section__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="gy-section__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    {%- if collection.products.size > 0 -%}
      <div class="gy-grid gy-grid--{{ section.settings.columns }}">
        {%- for product in collection.products limit: limit -%}
          <div class="gy-grid__item" data-gy-reveal style="--gy-reveal-delay: {{ forloop.index0 | times: 70 }}ms">
            {%- render 'gy-card-product', card_product: product, ratio: section.settings.image_ratio -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="gy-section__empty">{{ 'sections.gy.no_collection' | t }}</p>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="gy-section__foot" data-gy-reveal>
        <a class="gy-button gy-button--outline" href="{{ collection.url }}">
          {{ section.settings.view_all_text | default: 'View all' | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GentleYou product grid",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    {
      "type": "select", "id": "columns", "label": "Desktop columns", "default": "4",
      "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ]
    },
    {
      "type": "select", "id": "image_ratio", "label": "Image shape", "default": "portrait",
      "options": [ { "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" } ]
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The pieces everyone keeps coming back to." },
    { "type": "richtext", "id": "text", "label": "Supporting text" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' link", "default": true },
    { "type": "text", "id": "view_all_text", "label": "'View all' label", "default": "View all" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "style", "label": "Presentation", "default": "grid",
      "options": [ { "value": "grid", "label": "Even grid" }, { "value": "showcase", "label": "Showcase (large first product)" } ]
    },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "ivory",
      "options": [ { "value": "ivory", "label": "Warm ivory" }, { "value": "lavender", "label": "Soft lavender" }, { "value": "deep", "label": "Deep charcoal" } ]
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 180, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [ { "name": "GentleYou product grid" } ]
}
{% endschema %}
